{
  "name": "dsh-nikoapi",
  "version": "0.1.0",
  "description": "Connect NikoAPI (New API relay) keys and grouped models to DeepSeek Harness, with automatic cost-meter price linking.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "nikoapi",
    "new-api"
  ],
  "license": "MIT",
  "author": {
    "name": "SnowNight777",
    "email": "318125535+SnowNight777@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnowNight777/dsh-nikoapi.git"
  },
  "bugs": {
    "url": "https://github.com/SnowNight777/dsh-nikoapi/issues"
  },
  "homepage": "https://github.com/SnowNight777/dsh-nikoapi#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "images",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.3.0-0"
    }
  }
}